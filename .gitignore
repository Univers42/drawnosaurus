node_modules
# pnpm falls back to a store inside the repo when its configured store dir is not
# writable — never commit 100+MB of content-addressed packages.
.pnpm-store
dist
build
.svelte-kit
coverage
*.tsbuildinfo

# WASM build output inside the engine submodule (produced by `make wasm`).
engine/pkg
engine/target

# Snapshots, screenshots and console logs written by the Playwright MCP browser
# session — evidence from a run, not source.
.playwright-mcp

# Traces, screenshots and reports from `pnpm test:e2e`. The specs in e2e/ are source;
# what a run of them produced is not.
test-results
playwright-report
blob-report

# The Excalidraw parity reference, fetched by `make oracle` at the SHA pinned in
# scripts/oracle-sha.txt. ~100MB of someone else's history; the pin is the artefact
# worth committing, not the tree.
third_party/

.env
.env.local