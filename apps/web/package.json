{
  "name": "@drawnosaurus/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SvelteKit frontend. Mounts the Rust/WASM draw-engine on a canvas and autosaves scene diffs to the API.",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev --host 0.0.0.0 --port 5173",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "node build/index.js",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --exclude \"**/*.bench.ts\"",
    "test:bench": "vitest bench --run"
  },
  "dependencies": {
    "@drawnosaurus/contract": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.3.4",
    "@sveltejs/kit": "^2.48.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.42.2",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
