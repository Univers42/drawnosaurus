{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The Workers runtime is a web worker, not Node: Request, Response, WebSocket and
    // crypto are the WebWorker lib's. What Cloudflare adds to them is declared by hand in
    // src/cloudflare.ts — only what is used, so no @cloudflare/workers-types.
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
